{
  "name": "notes_creator",
  "version": "1.0.0",
  "description": "Flag Hunters: narrated Remotion film of a CTF reverse-engineering session",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "audio:synth": "python3 scripts/synthesize_audio.py",
    "typecheck": "tsc -p tsconfig.json",
    "render": "remotion render src/index.ts FlagHunters final-video.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --gl=swiftshader"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedant585457/notes_creator.git"
  },
  "keywords": [],
  "author": "",
